# PaymentPipeline — Environment Variables
# Copy to .env and adjust values

APP_ENV=development
LOG_LEVEL=DEBUG
DEBUG=false

# Server
API_PORT=5000
METRICS_PORT=8000

# Database (Mock Postgres pool backed by SQLite)
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=3.0
DB_FAILURE_RATE=0.12          # 12% chance of intermittent connection failure
DB_SLOW_QUERY_MS=200
SQLITE_PATH=./paymentpipeline.db

# Payment processing
PARTIAL_COMMIT_RATE=0.07      # 7% of transactions get partial commit bug
FEE_RATE=0.029                # 2.9% fee (float — intentional bug source)
MAX_TX_AMOUNT=50000.0
IDEMPOTENCY_TTL=3600

# Fraud detection
FRAUD_THRESHOLD=0.65
FRAUD_SCORE_BLEED=0.30        # Cross-transaction score bleed (cascade bug)
FRAUD_HIGH_AMOUNT=5000.0
FRAUD_CASCADE_COUNT=4

# Webhook
WEBHOOK_STORM_THRESHOLD=3
GATEWAY_RETRY_RATE=0.20       # 20% chance of simulated gateway retry
WEBHOOK_MAX_RETRIES=5

# Transaction generator
GEN_MIN_INTERVAL=2.0
GEN_MAX_INTERVAL=6.0
GEN_BATCH_SIZE=3
GEN_REFUND_RATE=0.15          # 15% of ticks also process a refund (deadlock trigger)
GEN_CACHE_MAX=0               # 0 = unbounded (memory leak)

# Reconciliation
RECON_INTERVAL=30
RECON_DRIFT_THRESHOLD=0.005
