{
  "agent_name": "PaymentPipeline-FraudDetectionAgent",
  "model_version": "v2.4-rules+ml-hybrid",
  "deployed_at": "2025-11-01T08:00:00Z",
  "environment": "production",

  "feature_store": {
    "type": "mock",
    "real_implementation": "feast",
    "feature_ttl_seconds": 300,
    "features": [
      "user.transaction_count_24h",
      "user.avg_transaction_amount_7d",
      "user.distinct_merchants_7d",
      "user.failed_transaction_rate_24h",
      "device.fingerprint_risk_score",
      "network.ip_reputation_score",
      "merchant.chargeback_rate_30d"
    ]
  },

  "scoring": {
    "block_threshold": 0.65,
    "review_threshold": 0.45,
    "score_bleed_factor": 0.30,
    "note": "score_bleed_factor causes cascade bug — known issue, not yet fixed"
  },

  "rules": {
    "high_amount_threshold": 5000.0,
    "medium_amount_threshold": 2000.0,
    "velocity_window_minutes": 60,
    "velocity_high_count": 8,
    "velocity_medium_count": 4,
    "off_hours_utc_start": 4,
    "off_hours_utc_end": 6,
    "round_amount_minimum": 100.0
  },

  "ml_model": {
    "type": "gradient_boosted_trees",
    "real_implementation": "xgboost",
    "mock_mean_score": 0.08,
    "mock_std_dev": 0.04,
    "feature_importance": {
      "transaction_amount": 0.28,
      "velocity_24h": 0.22,
      "ip_reputation": 0.18,
      "device_fingerprint": 0.15,
      "merchant_chargeback_rate": 0.10,
      "time_of_day": 0.07
    }
  },

  "decision_routing": {
    "block": {
      "action": "reject_transaction",
      "notify_team": "fraud-ops@paypipeline.internal",
      "kafka_topic": "fraud.decisions.block"
    },
    "review": {
      "action": "queue_for_manual_review",
      "sla_hours": 4,
      "kafka_topic": "fraud.decisions.review"
    },
    "allow": {
      "action": "proceed",
      "kafka_topic": "fraud.decisions.allow"
    }
  },

  "monitoring": {
    "prometheus_prefix": "fraud_agent",
    "alert_on_cascade": true,
    "cascade_threshold_checks": 4,
    "false_positive_rate_alert_threshold": 0.05
  },

  "known_issues": [
    {
      "id": "FRAUD-2247",
      "title": "Score cascade due to cross-transaction bleed",
      "severity": "high",
      "status": "open",
      "description": "score_bleed_factor=0.30 causes legitimate accounts to accumulate risk over time",
      "reported_at": "2025-09-15",
      "assigned_to": "ml-platform-team"
    },
    {
      "id": "FRAUD-2301",
      "title": "False positive rate elevated for INR transactions",
      "severity": "medium",
      "status": "in_progress",
      "description": "cross_currency rule adds 0.08 flat — disproportionate for high-volume INR accounts",
      "reported_at": "2025-10-02"
    }
  ]
}
